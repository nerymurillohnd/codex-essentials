{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "marketplace.schema.json",
  "title": "Codex Essentials Marketplace Catalog",
  "description": "Strict schema for the generated local Codex marketplace catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "interface", "plugins"],
  "properties": {
    "name": { "$ref": "#/$defs/identifier" },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/pluginEntry" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "category": {
      "enum": [
        "Productivity",
        "Creativity",
        "Developer Tools",
        "Business & Operations",
        "Data & Analytics",
        "Communication",
        "Education & Research",
        "Security",
        "Finance",
        "Healthcare",
        "Travel",
        "Entertainment",
        "Other"
      ]
    },
    "pluginEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "policy", "category"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "path"],
          "properties": {
            "source": { "const": "local" },
            "path": {
              "type": "string",
              "pattern": "^\\./plugins/[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["installation", "authentication"],
          "properties": {
            "installation": {
              "enum": ["NOT_AVAILABLE", "AVAILABLE", "INSTALLED_BY_DEFAULT"]
            },
            "authentication": { "enum": ["ON_INSTALL", "ON_USE"] },
            "products": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        "category": { "$ref": "#/$defs/category" }
      }
    }
  },
  "examples": [
    {
      "name": "codex-essentials",
      "interface": { "displayName": "Codex Essentials" },
      "plugins": [
        {
          "name": "example-plugin",
          "source": { "source": "local", "path": "./plugins/example-plugin" },
          "policy": {
            "installation": "AVAILABLE",
            "authentication": "ON_INSTALL"
          },
          "category": "Productivity"
        }
      ]
    }
  ]
}
