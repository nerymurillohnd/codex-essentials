{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin.schema.json",
  "title": "Codex Plugin Manifest",
  "description": "Strict local validation profile for .codex-plugin/plugin.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "description",
    "author",
    "homepage",
    "repository",
    "license",
    "keywords",
    "interface"
  ],
  "properties": {
    "name": { "$ref": "#/$defs/identifier" },
    "version": { "$ref": "#/$defs/semver" },
    "description": { "$ref": "#/$defs/nonEmptyString" },
    "author": { "$ref": "#/$defs/author" },
    "homepage": { "$ref": "#/$defs/httpsUrl" },
    "repository": { "$ref": "#/$defs/httpsUrl" },
    "license": { "$ref": "#/$defs/nonEmptyString" },
    "keywords": { "$ref": "#/$defs/nonEmptyStringArray" },
    "skills": { "const": "./skills/" },
    "mcpServers": {
      "oneOf": [
        { "const": "./.mcp.json" },
        { "$ref": "#/$defs/mcpServerMap" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mcp_servers"],
          "properties": {
            "mcp_servers": { "$ref": "#/$defs/mcpServerMap" }
          }
        }
      ]
    },
    "apps": { "const": "./.app.json" },
    "hooks": {
      "oneOf": [
        { "$ref": "#/$defs/pluginPath" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/pluginPath" }
        },
        { "type": "object", "minProperties": 1 },
        {
          "type": "array",
          "minItems": 1,
          "items": { "type": "object", "minProperties": 1 }
        }
      ]
    },
    "interface": { "$ref": "#/$defs/interface" }
  },
  "anyOf": [
    { "required": ["skills"], "properties": { "skills": {} } },
    { "required": ["hooks"], "properties": { "hooks": {} } },
    { "required": ["mcpServers"], "properties": { "mcpServers": {} } },
    { "required": ["apps"], "properties": { "apps": {} } }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    },
    "httpsUrl": { "type": "string", "pattern": "^https://[^\\s]+$" },
    "mcpServerMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "additionalProperties": { "$ref": "#/$defs/mcpServer" }
    },
    "mcpServer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": { "$ref": "#/$defs/nonEmptyString" },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "env": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "minLength": 1 },
          "additionalProperties": { "type": "string" }
        },
        "url": { "$ref": "#/$defs/httpsUrl" }
      },
      "oneOf": [
        { "required": ["command"], "properties": { "command": {} } },
        { "required": ["url"], "properties": { "url": {} } }
      ]
    },
    "pluginPath": {
      "type": "string",
      "allOf": [
        { "pattern": "^\\./[^\\r\\n]+$" },
        { "not": { "pattern": "(?:^|/)\\.\\.(?:/|$)" } }
      ]
    },
    "assetPath": {
      "type": "string",
      "allOf": [
        { "pattern": "^\\./assets/[^\\r\\n]+$" },
        { "not": { "pattern": "(?:^|/)\\.\\.(?:/|$)" } }
      ]
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "email", "url"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "email": {
          "type": "string",
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "url": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "category": {
      "enum": [
        "Productivity",
        "Creativity",
        "Developer Tools",
        "Business & Operations",
        "Data & Analytics",
        "Communication",
        "Education & Research",
        "Security",
        "Finance",
        "Healthcare",
        "Travel",
        "Entertainment",
        "Other"
      ]
    },
    "defaultPrompt": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 },
      "uniqueItems": true
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName",
        "shortDescription",
        "longDescription",
        "developerName",
        "category",
        "capabilities",
        "websiteURL",
        "privacyPolicyURL",
        "termsOfServiceURL",
        "defaultPrompt"
      ],
      "properties": {
        "displayName": { "$ref": "#/$defs/nonEmptyString" },
        "shortDescription": {
          "type": "string",
          "minLength": 1,
          "maxLength": 125
        },
        "longDescription": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "developerName": { "$ref": "#/$defs/nonEmptyString" },
        "category": { "$ref": "#/$defs/category" },
        "capabilities": { "$ref": "#/$defs/nonEmptyStringArray" },
        "websiteURL": { "$ref": "#/$defs/httpsUrl" },
        "privacyPolicyURL": { "$ref": "#/$defs/httpsUrl" },
        "termsOfServiceURL": { "$ref": "#/$defs/httpsUrl" },
        "defaultPrompt": { "$ref": "#/$defs/defaultPrompt" },
        "brandColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "composerIcon": { "$ref": "#/$defs/assetPath" },
        "logo": { "$ref": "#/$defs/assetPath" },
        "screenshots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assetPath" },
          "uniqueItems": true
        }
      }
    }
  }
}
