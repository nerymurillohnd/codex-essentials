{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "go",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "/",
  "separate-pull-requests": false,
  "draft": true,
  "force-tag-creation": true,
  "bump-minor-pre-major": true,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features",
      "hidden": false
    },
    {
      "type": "fix",
      "section": "Bug Fixes",
      "hidden": false
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": false
    },
    {
      "type": "deps",
      "section": "Dependencies",
      "hidden": false
    }
  ],
  "packages": {
    "plugins/astro-cli-commands": {
      "package-name": "astro-cli-commands",
      "component": "plugin/astro-cli-commands",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": ".codex-plugin/plugin.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "plugins/doc-keeper": {
      "package-name": "doc-keeper",
      "component": "plugin/doc-keeper",
      "initial-version": "0.1.0",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": ".codex-plugin/plugin.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "plugins/optimize-memories": {
      "package-name": "optimize-memories",
      "component": "plugin/optimize-memories",
      "initial-version": "0.1.0",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": ".codex-plugin/plugin.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "plugins/prettier-after-edit": {
      "package-name": "prettier-after-edit",
      "component": "plugin/prettier-after-edit",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": ".codex-plugin/plugin.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
