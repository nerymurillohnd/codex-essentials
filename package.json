{
  "name": "codex-essentials",
  "version": "1.0.0",
  "description": "Community marketplace for Codex skills and plugins.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "lib"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "tsc": "tsc --noEmit",
    "typecheck": "node lib/quality/typecheck.cjs",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json --pretty false",
    "test": "vitest run --passWithNoTests --coverage",
    "test:watch": "vitest --passWithNoTests",
    "validate:plugins": "node scripts/validate-plugins.cjs",
    "validate:github-labels": "node scripts/validate-github-labels.cjs",
    "generate:marketplace": "node scripts/generate-marketplace.cjs",
    "validate:marketplace": "node scripts/validate-marketplace.cjs",
    "validate:pr-title": "node scripts/validate-pr-title.cjs",
    "validate:pr-commits": "node scripts/validate-pr-commits.cjs",
    "validate:pr-scope": "node scripts/validate-pr-scope.cjs",
    "validate:release-set": "node scripts/validate-release-set.cjs",
    "validate:release-workflow": "node scripts/validate-release-workflow-outputs.cjs",
    "package:preflight": "node scripts/package-plugin.cjs --preflight --ref HEAD --output-dir dist/preflight --output dist/preflight-artifacts.json",
    "documentation:gate": "node scripts/documentation-gate.cjs",
    "marketplace:check": "npm run validate:plugins && npm run validate:marketplace",
    "marketplace:build": "npm run validate:plugins && npm run generate:marketplace && npm run validate:marketplace",
    "project:bootstrap": "node lib/projects/bootstrap.cjs",
    "check": "npm run format:check && npm run lint -- --max-warnings=0 && npm run typecheck && npm run typecheck:scripts && npx tsc6 --noEmit && npm run test && npm run validate:github-labels && npm run marketplace:check && npm run validate:release-workflow && npm run package:preflight"
  },
  "keywords": [],
  "author": "Nery Samuel Murillo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nerymurillohnd/codex-essentials.git"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "lint-staged": {
    "*.{js,cjs,mjs}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{ts,tsx,mts,cts,json,jsonc,yaml,yml,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.20.0",
    "eslint": "^10.9.1",
    "husky": "9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-language-server": "^6.0.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
