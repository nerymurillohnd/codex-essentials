{
  "name": "codex-essentials",
  "version": "1.0.0",
  "description": "Community marketplace for Codex skills and plugins.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "lib"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "tsc": "tsc --noEmit",
    "typecheck": "node lib/quality/typecheck.cjs",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json --pretty false",
    "test": "vitest run --passWithNoTests --coverage",
    "test:watch": "vitest --passWithNoTests",
    "scaffold:plugin": "node lib/cli/scaffold.cjs",
    "sync:all": "node lib/cli/sync.cjs --write",
    "sync:check": "node lib/cli/sync.cjs",
    "validate": "node lib/cli/validate.cjs",
    "validate:plugins": "node lib/cli/validate.cjs",
    "validate:all": "node lib/cli/validate.cjs",
    "documentation:gate": "node lib/documentation/gate.cjs",
    "validate:release": "node lib/validate/release-tag.cjs",
    "project:bootstrap": "node lib/projects/bootstrap.cjs",
    "check": "npm run format:check && npm run lint -- --max-warnings=0 && npm run typecheck && npm run typecheck:scripts && npx tsc6 --noEmit && npm run test && npm run validate:all"
  },
  "keywords": [],
  "author": "Nery Samuel Murillo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nerymurillohnd/codex-essentials.git"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "lint-staged": {
    "*.{js,cjs,mjs}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{ts,tsx,mts,cts,json,jsonc,yaml,yml,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.20.0",
    "eslint": "^10.9.1",
    "husky": "9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-language-server": "^6.0.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
