{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "files": {
    "includes": [
      "plugins/lsp-intelligence/src/**",
      "tests/lsp-intelligence/**",
      "scripts/build_lsp.mjs"
    ]
  }
}
