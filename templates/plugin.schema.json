{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin.schema.json",
  "title": "Codex Plugin Manifest",
  "description": "Schema for a .codex-plugin/plugin.json manifest accepted by the Codex plugin creator.",
  "$comment": "The plugin-creator validator currently rejects a top-level hooks field, so hooks are intentionally not part of this schema. Companion files referenced by apps and mcpServers must still exist and be validated separately.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "description", "author", "interface"],
  "properties": {
    "id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "name": {
      "$ref": "#/$defs/pluginIdentifier"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "description": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "author": {
      "$ref": "#/$defs/author"
    },
    "homepage": {
      "$ref": "#/$defs/httpsUrl"
    },
    "repository": {
      "$ref": "#/$defs/httpsUrl"
    },
    "license": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "keywords": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "skills": {
      "type": "string",
      "enum": ["./skills", "./skills/"]
    },
    "apps": {
      "const": "./.app.json"
    },
    "mcpServers": {
      "oneOf": [
        {
          "const": "./.mcp.json"
        },
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object"
          }
        }
      ]
    },
    "interface": {
      "$ref": "#/$defs/interface"
    }
  },
  "anyOf": [
    {
      "required": ["skills"],
      "properties": { "skills": {} }
    },
    {
      "required": ["apps"],
      "properties": { "apps": {} }
    },
    {
      "required": ["mcpServers"],
      "properties": { "mcpServers": {} }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "pluginIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "email": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName",
        "shortDescription",
        "longDescription",
        "developerName",
        "category",
        "capabilities"
      ],
      "properties": {
        "displayName": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "shortDescription": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "longDescription": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "developerName": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "category": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        },
        "defaultPrompt": {
          "$ref": "#/$defs/defaultPrompt"
        },
        "default_prompt": {
          "$ref": "#/$defs/defaultPrompt"
        },
        "brandColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "composerIcon": {
          "$ref": "#/$defs/assetPath"
        },
        "logo": {
          "$ref": "#/$defs/assetPath"
        },
        "logoDark": {
          "$ref": "#/$defs/assetPath"
        },
        "screenshots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/screenshotPath"
          },
          "uniqueItems": true
        },
        "websiteURL": {
          "$ref": "#/$defs/httpsUrl"
        },
        "privacyPolicyURL": {
          "$ref": "#/$defs/httpsUrl"
        },
        "termsOfServiceURL": {
          "$ref": "#/$defs/httpsUrl"
        }
      },
      "anyOf": [
        {
          "required": ["defaultPrompt"],
          "properties": { "defaultPrompt": {} }
        },
        {
          "required": ["default_prompt"],
          "properties": { "default_prompt": {} }
        }
      ],
      "not": {
        "required": ["defaultPrompt", "default_prompt"],
        "properties": {
          "defaultPrompt": {},
          "default_prompt": {}
        }
      }
    },
    "defaultPrompt": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      ]
    },
    "assetPath": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^\\./assets/[^\\r\\n]+$"
        },
        {
          "not": {
            "pattern": "(?:^|/)\\.\\.(?:/|$)"
          }
        }
      ]
    },
    "screenshotPath": {
      "allOf": [
        {
          "$ref": "#/$defs/assetPath"
        },
        {
          "type": "string",
          "pattern": "\\.[Pp][Nn][Gg]$"
        }
      ]
    }
  }
}
