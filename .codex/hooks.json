{
  "description": "Validate and regenerate the Codex Essentials marketplace after a plugin manifest edit.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/plugin-manifest-guard.cjs\"",
            "timeout": 30,
            "statusMessage": "Validating plugin manifest pipeline"
          }
        ]
      }
    ]
  }
}
