{
  "description": "Format and lint edited shell scripts.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.codex/hooks/shellcheck-after-edit.sh\" --scope \"$PWD\"",
            "timeout": 30,
            "statusMessage": "Formatting and linting edited shell scripts"
          }
        ]
      }
    ]
  }
}
