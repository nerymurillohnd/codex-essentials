{
  "description": "Format files with Prettier after Codex writes or edits them.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/prettier-format.sh\"",
            "timeout": 30,
            "statusMessage": "Formatting edited files with Prettier"
          }
        ]
      }
    ]
  }
}
