{
  "description": "Format Codex-edited files with the target project's local Prettier.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Write|Edit|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/format.mjs\"",
            "timeout": 30,
            "statusMessage": "Formatting edited files with Prettier"
          }
        ]
      }
    ]
  }
}
