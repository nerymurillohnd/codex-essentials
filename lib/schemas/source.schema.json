{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source.schema.json",
  "title": "Codex Essentials Declarative Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["marketplace", "plugins"],
  "properties": {
    "marketplace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "displayName"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "displayName": { "type": "string", "minLength": 1 }
      }
    },
    "plugins": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/plugin" }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "displayName",
        "shortDescription",
        "longDescription",
        "developerName",
        "category",
        "capabilities",
        "defaultPrompt"
      ],
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "shortDescription": { "type": "string", "minLength": 1 },
        "longDescription": { "type": "string", "minLength": 1 },
        "developerName": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "capabilities": { "$ref": "#/$defs/stringArray" },
        "defaultPrompt": { "type": "string", "minLength": 1 }
      }
    },
    "marketplacePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "installation", "authentication"],
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "installation": {
          "enum": ["NOT_AVAILABLE", "AVAILABLE", "INSTALLED_BY_DEFAULT"]
        },
        "authentication": { "enum": ["ON_INSTALL", "ON_USE"] }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "shortDescription", "defaultPrompt"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
        },
        "displayName": { "type": "string", "minLength": 1 },
        "shortDescription": { "type": "string", "minLength": 1 },
        "defaultPrompt": { "type": "string", "minLength": 1 }
      }
    },
    "assetPath": {
      "type": "string",
      "pattern": "^\\./assets/[^\\r\\n]+$",
      "not": { "pattern": "(?:^|/)\\.\\.(?:/|$)" }
    },
    "mcpServers": {
      "oneOf": [
        { "const": "./.mcp.json" },
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "minLength": 1 },
          "additionalProperties": { "type": "object" }
        }
      ]
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "description",
        "author",
        "repository",
        "license",
        "interface",
        "marketplace",
        "skills"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "description": { "type": "string", "minLength": 1 },
        "author": { "$ref": "#/$defs/author" },
        "repository": { "type": "string", "pattern": "^https://" },
        "license": { "type": "string", "minLength": 1 },
        "interface": { "$ref": "#/$defs/interface" },
        "marketplace": { "$ref": "#/$defs/marketplacePolicy" },
        "apps": { "const": "./.app.json" },
        "mcpServers": { "$ref": "#/$defs/mcpServers" },
        "assets": {
          "type": "array",
          "items": { "$ref": "#/$defs/assetPath" },
          "uniqueItems": true
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/skill" }
        }
      }
    }
  }
}
