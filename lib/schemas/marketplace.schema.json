{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "marketplace.schema.json",
  "title": "Codex Marketplace",
  "description": "Schema for a repository or personal Codex plugin marketplace.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "interface", "plugins"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Marketplace identifier.",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName"],
      "properties": {
        "displayName": {
          "type": "string",
          "description": "User-facing marketplace title.",
          "minLength": 1
        }
      }
    },
    "plugins": {
      "type": "array",
      "description": "Ordered plugin entries exposed by this marketplace.",
      "items": {
        "$ref": "#/$defs/pluginEntry"
      }
    }
  },
  "$defs": {
    "pluginIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 3,
      "allOf": [
        {
          "pattern": "^\\./[^\\r\\n]+$"
        },
        {
          "not": {
            "pattern": "(?:^|/)\\.\\.(?:/|$)"
          }
        }
      ]
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "gitRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s]+$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{7,64}$"
    },
    "localSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "path"],
      "properties": {
        "source": {
          "const": "local"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "gitRootSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "url"],
      "properties": {
        "source": {
          "const": "url"
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "ref": {
          "$ref": "#/$defs/gitRef"
        },
        "sha": {
          "$ref": "#/$defs/gitSha"
        }
      },
      "not": {
        "required": ["ref", "sha"],
        "properties": {
          "ref": {},
          "sha": {}
        }
      }
    },
    "gitSubdirectorySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "url", "path"],
      "properties": {
        "source": {
          "const": "git-subdir"
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "ref": {
          "$ref": "#/$defs/gitRef"
        },
        "sha": {
          "$ref": "#/$defs/gitSha"
        }
      },
      "not": {
        "required": ["ref", "sha"],
        "properties": {
          "ref": {},
          "sha": {}
        }
      }
    },
    "npmSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "package"],
      "properties": {
        "source": {
          "const": "npm"
        },
        "package": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:@[A-Za-z0-9][A-Za-z0-9._-]*/)?[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s]+$"
        },
        "registry": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installation", "authentication"],
      "properties": {
        "installation": {
          "type": "string",
          "enum": ["NOT_AVAILABLE", "AVAILABLE", "INSTALLED_BY_DEFAULT"]
        },
        "authentication": {
          "type": "string",
          "enum": ["ON_INSTALL", "ON_USE"]
        },
        "products": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "pluginEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "policy", "category"],
      "properties": {
        "name": {
          "$ref": "#/$defs/pluginIdentifier"
        },
        "source": {
          "oneOf": [
            {
              "$ref": "#/$defs/localSource"
            },
            {
              "$ref": "#/$defs/gitRootSource"
            },
            {
              "$ref": "#/$defs/gitSubdirectorySource"
            },
            {
              "$ref": "#/$defs/npmSource"
            }
          ]
        },
        "policy": {
          "$ref": "#/$defs/policy"
        },
        "category": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
